<ui:FluentWindow x:Class="ControllerMapper.Desktop.UI.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:core="clr-namespace:ControllerMapper.Desktop.Core"
 Title="Controller Mapper" Width="1280" Height="820" MinWidth="1000" MinHeight="700" WindowStartupLocation="CenterScreen"
 Background="{StaticResource AppBackgroundBrush}" Foreground="{StaticResource AppTextBrush}" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
 <Window.InputBindings><KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProfileCommand}" /><KeyBinding Key="F5" Command="{Binding RefreshDevicesCommand}" /><KeyBinding Key="Escape" Command="{Binding StopCommand}" /></Window.InputBindings>
 <Grid Background="{StaticResource AppBackgroundBrush}">
  <Grid.RowDefinitions><RowDefinition Height="112" /><RowDefinition /><RowDefinition Height="96" /></Grid.RowDefinitions>
  <Border x:Name="WindowDragRegion" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
  <Grid Margin="52,28,52,18" IsEnabled="{Binding IsWorkspaceEnabled}">
   <Button HorizontalAlignment="Left" Style="{StaticResource IconButton}" Command="{Binding GoBackCommand}" Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=NotHome}" AutomationProperties.Name="返回配置首页"><ui:SymbolIcon Symbol="ChevronLeft24" FontSize="24" /></Button>
   <TextBlock Text="{Binding PageTitle}" FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Center" />
   <Button HorizontalAlignment="Right" Style="{StaticResource ActionButton}" Content="设备说明" Command="{Binding NavigateCommand}" CommandParameter="Device" ToolTip="查看设备与运行说明" AutomationProperties.Name="设备与运行说明" />
  </Grid>
  </Border>
  <Grid Grid.Row="1" Margin="48,0" IsEnabled="{Binding IsWorkspaceEnabled}">
   <!-- Profile hub -->
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Home}">
    <StackPanel MaxWidth="944" Margin="0,6,0,20">
     <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" DisplayMemberPath="Name" Width="230" HorizontalAlignment="Center" MinHeight="38" AutomationProperties.Name="当前全局配置" />
     <TextBlock Text="{Binding SavedProfileSummary}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" Margin="0,9,0,0" />
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0"><Button Content="查看已保存配置" Style="{StaticResource ActionButton}" Command="{Binding NavigateCommand}" CommandParameter="Profiles" Margin="0,0,10,0" /><Button Content="新建配置" Style="{StaticResource ActionButton}" Command="{Binding NewProfileCommand}" /></StackPanel>
     <TextBlock Text="请选择您想自定义的设置。" HorizontalAlignment="Center" Margin="0,20,0,30" />
     <UniformGrid Columns="2" Rows="2">
      <Button Style="{StaticResource MenuCard}" Height="180" Margin="0,0,8,8" Command="{Binding NavigateCommand}" CommandParameter="Mapping" AutomationProperties.Name="打开自定义按键配置"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="132" /><ColumnDefinition /></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="Games24" FontSize="65" VerticalAlignment="Center" HorizontalAlignment="Center" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="自定义按键配置" FontSize="17" /><TextBlock Text="更改按钮输出，设置组合按键与 Shift 分层。" Style="{StaticResource CaptionStyle}" Margin="0,14,0,0" /></StackPanel></Grid></Button>
      <Button Style="{StaticResource MenuCard}" Height="180" Margin="8,0,0,8" Command="{Binding NavigateCommand}" CommandParameter="Turbo" AutomationProperties.Name="打开单键连发"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="132" /><ColumnDefinition /></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="Flash24" FontSize="65" VerticalAlignment="Center" HorizontalAlignment="Center" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="单键连发" FontSize="17" /><TextBlock Text="选择触发键与重复间隔，按住触发，松开停止。" Style="{StaticResource CaptionStyle}" Margin="0,14,0,0" /></StackPanel></Grid></Button>
      <Button Style="{StaticResource MenuCard}" Height="180" Margin="0,8,8,0" Command="{Binding NavigateCommand}" CommandParameter="Profiles" AutomationProperties.Name="打开配置管理"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="132" /><ColumnDefinition /></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="FolderOpen24" FontSize="65" VerticalAlignment="Center" HorizontalAlignment="Center" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="配置文件" FontSize="17" /><TextBlock Text="新建、复制或切换全局配置，导入与导出设置。" Style="{StaticResource CaptionStyle}" Margin="0,14,0,0" /></StackPanel></Grid></Button>
      <Button Style="{StaticResource MenuCard}" Height="180" Margin="8,8,0,0" Command="{Binding NavigateCommand}" CommandParameter="Device" AutomationProperties.Name="打开设备与运行"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="132" /><ColumnDefinition /></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="PlugConnected24" FontSize="65" VerticalAlignment="Center" HorizontalAlignment="Center" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="设备与运行" FontSize="17" /><TextBlock Text="连接您的控制器，查看输入状态并启用映射。" Style="{StaticResource CaptionStyle}" Margin="0,14,0,0" /></StackPanel></Grid></Button>
     </UniformGrid>
    </StackPanel>
   </ScrollViewer>
   <!-- Controller mapping overview -->
   <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Mapping}">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,10"><TextBlock Text="点选图中的输入键，或点下方“添加 / 修改键位”，选择虚拟手柄输出键。" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" /><TextBlock Text="{Binding InputLayoutText}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" TextAlignment="Center" /></StackPanel>
    <Viewbox Grid.Row="1" Stretch="Uniform" MaxWidth="910" MaxHeight="465" Margin="12,0">
     <Canvas Width="900" Height="450">
      <Image Canvas.Left="150" Canvas.Top="15" Width="600" Height="400" Style="{StaticResource FadedController}" />
      <Path Stroke="#A4A6B2" StrokeThickness="0.8" Opacity="0.8" IsHitTestVisible="False" Data="M140,45 H225 L310,68 M140,99 H260 L347,104 M140,153 H240 L294,119 M140,207 H215 L266,145 M140,261 H235 L294,172 M140,315 H250 L322,145 M140,369 H300 L370,214 M760,45 H675 L605,68 M760,99 H660 L552,104 M760,153 H680 L606,114 M760,207 H695 L638,145 M760,261 H665 L606,175 M760,315 H650 L573,144 M760,369 H615 L528,214" />
      <Button Canvas.Left="292" Canvas.Top="0" Tag="{x:Static core:GamepadButton.LeftTrigger}" Style="{StaticResource PadButton}" />
      <Button Canvas.Left="502" Canvas.Top="0" Tag="{x:Static core:GamepadButton.RightTrigger}" Style="{StaticResource PadButton}" />
      <Button Canvas.Left="34" Canvas.Top="26" Tag="{x:Static core:GamepadButton.LeftShoulder}" Style="{StaticResource PadButton}" />
      <Button Canvas.Left="34" Canvas.Top="80" Tag="{x:Static core:GamepadButton.Back}" Style="{StaticResource PadButton}" />
      <Button Canvas.Left="34" Canvas.Top="134" Tag="{x:Static core:GamepadButton.DPadUp}" Style="{StaticResource PadButton}" />
      <Button Canvas.Left="34" Canvas.Top="188" Tag="{x:Static core:GamepadButton.DPadLeft}" Style="{StaticResource PadButton}" />
      <Button Canvas.Left="34" Canvas.Top="242" Tag="{x:Static core:GamepadButton.DPadDown}" Style="{StaticResource PadButton}" />
      <Button Canvas.Left="34" Canvas.Top="296" Tag="{x:Static core:GamepadButton.DPadRight}" Style="{StaticResource PadButton}" />
      <Button Canvas.Left="34" Canvas.Top="350" Tag="{x:Static core:GamepadButton.LeftStick}" Style="{StaticResource PadButton}" />
      <Button Canvas.Left="760" Canvas.Top="26" Tag="{x:Static core:GamepadButton.RightShoulder}" Style="{StaticResource PadButton}" />
      <Button Canvas.Left="760" Canvas.Top="80" Tag="{x:Static core:GamepadButton.Start}" Style="{StaticResource PadButton}" />
      <Button Canvas.Left="760" Canvas.Top="134" Tag="{x:Static core:GamepadButton.Y}" Style="{StaticResource PadButton}" />
      <Button Canvas.Left="760" Canvas.Top="188" Tag="{x:Static core:GamepadButton.B}" Style="{StaticResource PadButton}" />
      <Button Canvas.Left="760" Canvas.Top="242" Tag="{x:Static core:GamepadButton.A}" Style="{StaticResource PadButton}" />
      <Button Canvas.Left="760" Canvas.Top="296" Tag="{x:Static core:GamepadButton.X}" Style="{StaticResource PadButton}" />
      <Button Canvas.Left="760" Canvas.Top="350" Tag="{x:Static core:GamepadButton.RightStick}" Style="{StaticResource PadButton}" />
      <Button Canvas.Left="293" Canvas.Top="409" Tag="{x:Static core:GamepadButton.LeftPaddle}" Style="{StaticResource PadButton}" />
      <Button Canvas.Left="501" Canvas.Top="409" Tag="{x:Static core:GamepadButton.RightPaddle}" Style="{StaticResource PadButton}" />
     </Canvas>
    </Viewbox>
    <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,8,0,8"><TextBlock Text="扳机按下超过半程才触发按键映射 · 未映射扳机保留模拟量" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" /><TextBlock Text="映射只改变虚拟手柄；原手柄若被游戏同时读取，原按键仍可能生效。" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0"><Button Content="添加 / 修改键位" Command="{Binding SelectSourceCommand}" CommandParameter="{x:Static core:GamepadButton.A}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" /><Button Command="{Binding ShowMappingsCommand}" Style="{StaticResource ActionButton}" Margin="0,0,10,0"><TextBlock Text="{Binding Mappings.Count, StringFormat=查看映射规则（{0}）}" /></Button><Button Content="启用映射" Command="{Binding ArmCommand}" Style="{StaticResource ActionButton}" /></StackPanel></StackPanel>
   </Grid>
   <!-- Turbo -->
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Turbo}">
    <Grid MaxWidth="1000" Margin="20,28,20,10"><Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="50" /><ColumnDefinition /></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="触发与输出" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="按住触发键时，重复输出单个手柄键或全幅扳机。" Style="{StaticResource CaptionStyle}" Margin="0,16,0,26" /><TextBlock Text="触发按键（实体手柄）" Style="{StaticResource FieldLabelStyle}" /><ComboBox ItemsSource="{Binding OptionalInputButtonOptions}" DisplayMemberPath="Label" SelectedValuePath="Button" SelectedValue="{Binding TurboTrigger, Mode=TwoWay}" AutomationProperties.Name="连发触发按钮" /><TextBlock Text="输出键 / 扳机（虚拟 Xbox 360）" Style="{StaticResource FieldLabelStyle}" Margin="0,22,0,10" /><ComboBox ItemsSource="{Binding OptionalOutputButtons}" ItemTemplate="{StaticResource ButtonOptionTemplate}" SelectedItem="{Binding TurboTarget, Mode=TwoWay}" AutomationProperties.Name="连发目标按钮" />
      <TextBlock Text="重复间隔" Style="{StaticResource SectionTitleStyle}" Margin="0,36,0,20" /><ui:NumberBox Value="{Binding TurboIntervalMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="50" Maximum="1000" MaxDecimalPlaces="0" SmallChange="10" LargeChange="100" AcceptsExpression="False" AutomationProperties.Name="连发间隔毫秒" /><Slider Value="{Binding TurboIntervalMs, Mode=TwoWay}" Minimum="50" Maximum="1000" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,20,0,12" AutomationProperties.Name="调整连发间隔" /><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="50 — 1000 毫秒" Style="{StaticResource CaptionStyle}" /><TextBlock Grid.Column="1" Text="{Binding TurboRateText}" /></Grid><Button Content="关闭单键连发" Command="{Binding DisableTurboCommand}" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Margin="0,24,0,0" />
     </StackPanel>
     <StackPanel Grid.Column="2" VerticalAlignment="Center"><Image Style="{StaticResource FadedController}" Height="310" /><TextBlock Text="按住触发 · 松开停止" FontSize="18" HorizontalAlignment="Center" Margin="0,20,0,0" /><TextBlock Text="切换前台窗口后，请松开触发键再按下。&#10;设备断开或安全门关闭时，输出会停止。" Style="{StaticResource CaptionStyle}" TextAlignment="Center" Margin="18,16,18,0" /></StackPanel>
    </Grid>
   </ScrollViewer>
   <!-- Profile management -->
   <Grid MaxWidth="944" Margin="0,28,0,10" Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Profiles}">
    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="64" /><ColumnDefinition /></Grid.ColumnDefinitions>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="我的配置" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,20" /><ListBox Grid.Row="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" ItemContainerStyle="{StaticResource ProfileItem}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="配置文件列表"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" /></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,18,0,0"><Button Content="新建配置" Style="{StaticResource ActionButton}" Command="{Binding NewProfileCommand}" Margin="0,0,12,0" /><Button Content="复制" Style="{StaticResource ActionButton}" Command="{Binding DuplicateProfileCommand}" /></StackPanel></Grid>
    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="配置名称" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,20" /><ui:TextBox Text="{Binding ProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="配置名称" /><TextBlock Text="当前选择的配置全局生效，由您手动切换。修改配置会停止当前输出，完成后请重新启用。" Style="{StaticResource CaptionStyle}" Margin="0,16,0,36" /><TextBlock Text="导入与导出" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="以 JSON 文件保存或分享当前设置。导入会追加一个配置，并保存所有配置。" Style="{StaticResource CaptionStyle}" Margin="0,16,0,22" /><StackPanel Orientation="Horizontal"><Button Content="导入 JSON" Style="{StaticResource ActionButton}" Command="{Binding ImportProfileCommand}" Margin="0,0,12,0" /><Button Content="导出 JSON" Style="{StaticResource ActionButton}" Command="{Binding ExportProfileCommand}" /></StackPanel><Button Content="编辑这个配置" Style="{StaticResource PrimaryButton}" Command="{Binding GoBackCommand}" HorizontalAlignment="Left" Margin="0,38,0,0" /></StackPanel></ScrollViewer>
   </Grid>
   <!-- Device page -->
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Device}">
    <Grid MaxWidth="1000" Margin="0,26,0,16"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="70" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="连接控制器" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="连接 Xbox 或 DualSense 手柄；软件会自动检查，也可手动刷新。" Style="{StaticResource CaptionStyle}" Margin="0,16,0,20" /><ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" AutomationProperties.Name="物理手柄" ToolTip="{Binding SelectedDevice}" /><TextBlock Text="{Binding DeviceStatusText}" Style="{StaticResource CaptionStyle}" Margin="0,12,0,16" /><Button Content="刷新设备" Style="{StaticResource ActionButton}" Command="{Binding RefreshDevicesCommand}" HorizontalAlignment="Left" /><TextBlock Text="运行控制" Style="{StaticResource SectionTitleStyle}" Margin="0,38,0,16" /><TextBlock Text="{Binding SafetyText}" Style="{StaticResource CaptionStyle}" Margin="0,0,0,18" /><WrapPanel><Button Content="启用 / 恢复映射" Style="{StaticResource PrimaryButton}" Command="{Binding ArmCommand}" Margin="0,0,12,12" /><Button Content="立即停止" Style="{StaticResource ActionButton}" Command="{Binding StopCommand}" Margin="0,0,0,12" /></WrapPanel><TextBlock Text="实时输入（启用后显示）" Style="{StaticResource FieldLabelStyle}" Margin="0,24,0,10" /><TextBlock Text="{Binding LiveInputText}" TextWrapping="Wrap" Foreground="#78AFF0" /></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="设备能力" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{Binding CapabilityText}" Style="{StaticResource CaptionStyle}" Margin="0,16,0,26" /><TextBlock Text="虚拟手柄输出" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="输出为 Xbox 360 兼容手柄，需要用户自行安装兼容的 ViGEmBus 驱动。物理手柄不会自动屏蔽，请避免双重输入。" Style="{StaticResource CaptionStyle}" Margin="0,16,0,26" /><TextBlock Text="功能范围" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="当前支持按键与半程扳机映射、Shift 分层和单键连发。摇杆曲线、扳机死区与震动强度尚未实现。设备能力仍需实机验收。" Style="{StaticResource CaptionStyle}" Margin="0,16,0,26" /><TextBlock Text="快捷键与说明" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="Ctrl + S 保存配置 · F5 刷新设备&#10;Esc 立即停止（仅在本窗口内生效）&#10;&#10;仅用于单机游戏、模拟器与生产力应用。与 Sony、Microsoft 无关联。" Style="{StaticResource CaptionStyle}" Margin="0,16,0,0" /></StackPanel>
    </Grid>
   </ScrollViewer>
  </Grid>
  <!-- Persistent actions -->
  <Grid Grid.Row="2" Margin="60,14,60,20" IsEnabled="{Binding IsWorkspaceEnabled}"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center" Margin="0,0,24,0"><TextBlock FontSize="11" Margin="0,0,0,4"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="映射未启用" /><Setter Property="Foreground" Value="#9297A8" /><Style.Triggers><DataTrigger Binding="{Binding IsArmed}" Value="True"><Setter Property="Text" Value="映射已启用" /><Setter Property="Foreground" Value="#8BB9F0" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" /><TextBlock Text="{Binding ValidationMessage}" Foreground="#F1BA80" TextTrimming="CharacterEllipsis" ToolTip="{Binding ValidationMessage}" Visibility="{Binding HasValidationError, Converter={StaticResource BoolVisibility}}" /><TextBlock Text="存在未保存的修改" Foreground="#D3BF93" FontSize="11" Margin="0,4,0,0" Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolVisibility}}" /></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="立即停止" Command="{Binding StopCommand}" Style="{StaticResource ActionButton}" MinWidth="132" Margin="0,0,14,0" ToolTip="停止并释放输出 · Esc" /><Button Content="保存配置" Command="{Binding SaveProfileCommand}" Style="{StaticResource PrimaryButton}" MinWidth="166" ToolTip="保存所有配置 · Ctrl+S" /></StackPanel>
  </Grid>
  <!-- Mapping editor, opened by controller callouts -->
  <Grid Grid.RowSpan="3" Background="#BC03050B" Visibility="{Binding IsMappingEditorOpen, Converter={StaticResource BoolVisibility}}" KeyboardNavigation.TabNavigation="Cycle">
   <Border Style="{StaticResource ModalCard}" Margin="24"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <Grid Margin="0,0,0,20"><TextBlock Text="编辑按键映射" FontSize="21" VerticalAlignment="Center" /><Button HorizontalAlignment="Right" Command="{Binding CloseOverlayCommand}" Style="{StaticResource IconButton}" AutomationProperties.Name="关闭按键编辑"><ui:SymbolIcon Symbol="Dismiss24" /></Button></Grid>
    <TextBlock Text="输入按钮（实体手柄）" Style="{StaticResource FieldLabelStyle}" /><ComboBox x:Name="MappingSourceSelector" ItemsSource="{Binding InputButtonOptions}" DisplayMemberPath="Label" SelectedValuePath="Button" SelectedValue="{Binding NewMappingSource, Mode=TwoWay}" AutomationProperties.Name="映射输入按钮" />
    <TextBlock Text="输出键 / 扳机" Style="{StaticResource FieldLabelStyle}" Margin="0,20,0,10" /><ComboBox ItemsSource="{Binding OutputButtons}" ItemTemplate="{StaticResource ButtonOptionTemplate}" SelectedItem="{Binding NewMappingTarget, Mode=TwoWay}" AutomationProperties.Name="映射输出按钮" />
    <TextBlock Text="同时输出第二控制项（可选）" Style="{StaticResource FieldLabelStyle}" Margin="0,20,0,10" /><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding OutputButtons}" ItemTemplate="{StaticResource ButtonOptionTemplate}" SelectedItem="{Binding NewMappingSecondTarget, Mode=TwoWay}" AutomationProperties.Name="组合输出第二按钮" /><Button Grid.Column="1" Content="清除" Style="{StaticResource ActionButton}" Command="{Binding ClearSecondTargetCommand}" Padding="16,6" Margin="10,0,0,0" /></Grid>
    <TextBlock Text="Shift 层切换按钮" Style="{StaticResource FieldLabelStyle}" Margin="0,20,0,10" /><ComboBox ItemsSource="{Binding OptionalInputButtonOptions}" DisplayMemberPath="Label" SelectedValuePath="Button" SelectedValue="{Binding EditorShiftButton, Mode=TwoWay}" AutomationProperties.Name="Shift 层切换按钮" /><CheckBox Content="此映射仅在 Shift 层生效" IsChecked="{Binding NewMappingShifted, Mode=TwoWay}" Margin="0,16,0,0" />
    <TextBlock Text="{Binding MappingFeedback}" Foreground="#F1BA80" TextWrapping="Wrap" Margin="0,12,0,0" /><TextBlock Text="选择实体输入键与虚拟输出键；同一输入、同一层的旧规则会被替换。确认后保存配置，再启用映射。" Style="{StaticResource CaptionStyle}" Margin="0,12,0,22" />
    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions><Button Content="取消" Style="{StaticResource ActionButton}" Command="{Binding CloseOverlayCommand}" /><Button Grid.Column="2" Content="确认映射" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyMappingCommand}" /></Grid>
   </StackPanel></ScrollViewer></Border>
  </Grid>
  <Grid Grid.RowSpan="3" Background="#BC03050B" Visibility="{Binding IsMappingListOpen, Converter={StaticResource BoolVisibility}}" KeyboardNavigation.TabNavigation="Cycle">
   <Border Style="{StaticResource ModalCard}" Width="590" Margin="24"><Grid MaxHeight="520"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Margin="0,0,0,20"><TextBlock Text="当前映射规则" FontSize="21" VerticalAlignment="Center" /><Button x:Name="MappingListClose" HorizontalAlignment="Right" Command="{Binding CloseOverlayCommand}" Style="{StaticResource IconButton}" AutomationProperties.Name="关闭映射列表"><ui:SymbolIcon Symbol="Dismiss24" /></Button></Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="尚未添加映射。关闭此窗口，选择手柄周围的按钮开始配置。" Margin="0,0,0,16"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Mappings.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <ItemsControl ItemsSource="{Binding Mappings}" AutomationProperties.Name="当前映射列表"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#2B2E3A" CornerRadius="8" Padding="14" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock TextWrapping="Wrap"><Run><Run.Text><MultiBinding Converter="{StaticResource InputButtonLabel}"><Binding Path="Source" /><Binding Path="DataContext.SelectedDevice" RelativeSource="{RelativeSource AncestorType=Window}" /></MultiBinding></Run.Text></Run><Run Text=" → " /><Run Text="{Binding Target, Converter={StaticResource ButtonLabel}, Mode=OneWay}" /></TextBlock><TextBlock Text="{Binding SecondTarget, Converter={StaticResource ButtonLabel}, StringFormat=同时输出：{0}}" Margin="0,5,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}"><Style.Triggers><DataTrigger Binding="{Binding SecondTarget}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding SecondTarget}" Value="{x:Static core:GamepadButton.None}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="Shift 层" Foreground="#8BB9F0" Margin="0,5,0,0" Visibility="{Binding Shifted, Converter={StaticResource BoolVisibility}}" /></StackPanel><Button Grid.Column="1" Content="移除" Style="{StaticResource ActionButton}" Padding="16,6" Margin="12,0,0,0" Command="{Binding DataContext.RemoveMappingCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
    <TextBlock Grid.Row="2" Text="未映射的按钮保持原始输出。移除规则后请保存配置。" Style="{StaticResource CaptionStyle}" Margin="0,18,0,0" />
   </Grid></Border>
  </Grid>
 </Grid>
</ui:FluentWindow>




